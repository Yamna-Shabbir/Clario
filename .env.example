# .env.example — Clario AI Meeting Assistant
#
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
#   cp .env.example .env
#
# All variables are optional unless marked REQUIRED.

# ── Flask / server ────────────────────────────────────────────────────────────

# REQUIRED in production (DEBUG=False). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In DEBUG mode a random key is auto-generated if this is absent (sessions
# will not persist across restarts).
CLARIO_SECRET_KEY=replace-me-with-a-long-random-string

# Set to True for local development; False (or omit) for production.
# On Render this must be False.
CLARIO_DEBUG=True

# TCP port the development server listens on (Render sets $PORT itself).
CLARIO_PORT=5000

# ── Paths ─────────────────────────────────────────────────────────────────────

# Root directory for all runtime data (transcripts, summaries, graphs, eval).
# Defaults to <project_root>/data
# On Render with a persistent disk, use /var/data
# CLARIO_DATA_DIR=data

# SQLite database file location.
# CLARIO_DB_PATH=data/database/clario.db

# Directory where uploaded audio files are saved.
# CLARIO_UPLOAD_DIR=uploads

# Where Hugging Face speech / translation weights are stored (off the system cache).
# CLARIO_HF_MODELS_DIR=data/hf-models

# Maximum allowed file upload size in megabytes (default 200).
# On Render free/standard edge limits, 100 is safer.
CLARIO_MAX_UPLOAD_MB=200

# Legacy graph output directory (not served by the UI).
# CLARIO_GRAPH_DIR=data/graphs

# Meeting chart PNGs (served at /static/graphs/...). On Render use /var/data/graphs.
# CLARIO_STATIC_GRAPH_DIR=static/graphs

# ── AI / ML models ────────────────────────────────────────────────────────────

# Primary ASR: Urdu Sukhan v1 (gated). Set HF_TOKEN after requesting access.
# If the gated model cannot load, Clario uses the public Whisper size below.
CLARIO_WHISPER_MODEL=Loudness-ai/urdu-sukhan-asr-v1
CLARIO_WHISPER_FALLBACK=small
CLARIO_WHISPER_TASK=translate
CLARIO_WHISPER_LANGUAGE=auto
CLARIO_WHISPER_INITIAL_PROMPT=Business meeting in English and Urdu.

# Optional: transcribe on this PC while Render stays on the free plan.
# Run: python scripts/local_transcription_server.py
# Then point a tunnel at http://127.0.0.1:8765 and set the public HTTPS URL
# on Render. Use the same token in both places. Leave both blank to keep
# in-process Whisper locally, or paste-only mode on the free plan.
# CLARIO_LOCAL_TRANSCRIPTION_URL=https://your-tunnel.example
# CLARIO_LOCAL_TRANSCRIPTION_TOKEN=replace-with-at-least-16-random-characters
# Hugging Face token (Render secret). Required for gated Sukhan downloads.
# HF_TOKEN=
# Marian MT fallback when pasted transcripts contain Urdu script.
CLARIO_ENABLE_TEXT_TRANSLATION=True
CLARIO_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ur-en

# HuggingFace summarisation model (default: sshleifer/distilbart-cnn-12-6 for ~40% faster CPU inference).
# Set to facebook/bart-large-cnn for slightly better standalone quality at ~40% slower CPU speed.
CLARIO_BART_MODEL=sshleifer/distilbart-cnn-12-6

# spaCy language model (run: python -m spacy download en_core_web_sm first).
CLARIO_SPACY_MODEL=en_core_web_sm

# ── Summarisation tuning ──────────────────────────────────────────────────────

# Token chunk size for map-reduce summarization (max ~700 tokens per chunk).
CLARIO_SUMMARY_CHUNK_TOKENS=700

# Deprecated (retained for backward compatibility; chunking handles full transcript).
# CLARIO_SUMMARY_MAX_INPUT_CHARS=1000

# Token length bounds for the generated summary.
CLARIO_SUMMARY_MAX_LENGTH=150
CLARIO_SUMMARY_MIN_LENGTH=50

# ── Google Integration / OAuth ────────────────────────────────────────────────
# Google Cloud OAuth 2.0 Web Client credentials for Google Meet integration
CLARIO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLARIO_GOOGLE_CLIENT_SECRET=your-google-client-secret
# Base URL for OAuth redirect callback (must match Google Console Authorized redirect URIs).
# Local: http://127.0.0.1:5000
# Render: https://YOUR-SERVICE.onrender.com
CLARIO_OAUTH_REDIRECT_BASE=http://127.0.0.1:5000
# 32-byte URL-safe base64 Fernet encryption key used to encrypt OAuth tokens in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLARIO_TOKEN_ENCRYPTION_KEY=

# ── Follow-up email ───────────────────────────────────────────────────────────
# After a meeting, assignees and the owner receive a summary PDF.
# Leave the host empty to write copies into CLARIO_EMAIL_DIR instead of sending.
CLARIO_SMTP_HOST=
CLARIO_SMTP_PORT=587
CLARIO_SMTP_USER=
CLARIO_SMTP_PASSWORD=
CLARIO_SMTP_FROM=
CLARIO_SMTP_TLS=True
# HTTPS mail works on Render free (SMTP ports 587/465 are blocked there).
# Brevo: https://app.brevo.com → SMTP & API → API keys. Verify the sender email first.
# CLARIO_BREVO_API_KEY=
# Resend is an alternative. A custom From address needs a verified domain.
# CLARIO_RESEND_API_KEY=
# CLARIO_EMAIL_DIR=data/outbox

